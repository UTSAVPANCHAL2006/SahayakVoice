{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "cd frontend && npm install",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sahayakvoice-backend.up.railway.app/api/:path*"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://sahayakvoice-backend.up.railway.app",
    "NEXT_PUBLIC_WS_URL": "wss://sahayakvoice-backend.up.railway.app",
    "NEXT_PUBLIC_DEMO_SUPERVISOR_PANEL": "true"
  }
}
